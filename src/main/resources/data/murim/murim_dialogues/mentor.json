        { "text": "dialogue.murim.mentor.opt.how_spar", "when": [ { "flag": "lesson.spar", "not_flag": "spar.clean3" } ], "next": "spar_hint" },
        { "text": "dialogue.murim.mentor.opt.next", "when": [ { "flag": "lesson.spar.done" } ], "next": "beyond" },
